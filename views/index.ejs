    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: #0a1628;
        background: radial-gradient(
          circle at 50% 50%,
          #1e3a8a 0%,
          #0a1628 50%,
          #050b14 100%
        );
        min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          Oxygen, Ubuntu, Cantarell, sans-serif;
        color: #e2e8f0;
        position: relative;
        overflow-x: hidden;
      }

      body::before {
        content: "";
        position: fixed;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(
            circle at 30% 40%,
            rgba(59, 130, 246, 0.15) 0%,
            transparent 50%
          ),
          radial-gradient(
            circle at 70% 60%,
            rgba(37, 99, 235, 0.1) 0%,
            transparent 50%
          );
        animation: pulse 15s ease-in-out infinite;
        pointer-events: none;
        z-index: 0;
      }

      @keyframes pulse {
        0%,
        100% {
          transform: translate(0, 0) scale(1);
        }
        50% {
          transform: translate(-5%, -5%) scale(1.1);
        }
      }

      .container {
        max-width: 600px;
        width: 94%;
        margin: 0 auto;
        overflow: scroll;
        position: relative;
        z-index: 1;
        padding: 16px 0;
      }

      h1 {
        font-size: 2.5rem;
        font-weight: 700;
        background: linear-gradient(135deg, #deecff 0%, #dbceff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 2rem;
        text-align: center;
        letter-spacing: -0.02em;
      }

      /* Glass morphism styles */
      .glass {
        background: rgba(30, 58, 138, 0.2);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(96, 165, 250, 0.2);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37),
          inset 0 1px 0 0 rgba(255, 255, 255, 0.05);
      }

      .glass-input {
        background: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(96, 165, 250, 0.3);
        color: #e2e8f0;
        padding: 0.75rem 1rem;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
        outline: none;
      }

      .glass-input:focus {
        border-color: rgba(96, 165, 250, 0.6);
        box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.1),
          0 4px 16px rgba(59, 130, 246, 0.2);
        background: rgba(15, 23, 42, 0.7);
      }

      .glass-input::placeholder {
        color: rgba(226, 232, 240, 0.4);
      }

      .glass-button {
        background: linear-gradient(
          135deg,
          rgba(59, 130, 246, 0.4) 0%,
          rgba(37, 99, 235, 0.4) 100%
        );
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(96, 165, 250, 0.4);
        color: #e2e8f0;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 16px rgba(59, 130, 246, 0.2);
        position: relative;
        overflow: hidden;
      }

      .glass-button::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(255, 255, 255, 0.2),
          transparent
        );
        transition: left 0.5s ease;
      }

      .glass-button:hover::before {
        left: 100%;
      }

      .glass-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(59, 130, 246, 0.4);
        border-color: rgba(96, 165, 250, 0.6);
      }

      .glass-button:active {
        transform: translateY(0);
      }

      .glass-button.green {
        background: linear-gradient(
          135deg,
          rgba(34, 197, 94, 0.4) 0%,
          rgba(22, 163, 74, 0.4) 100%
        );
        border-color: rgba(74, 222, 128, 0.4);
      }

      .glass-button.green:hover {
        box-shadow: 0 6px 24px rgba(34, 197, 94, 0.4);
        border-color: rgba(74, 222, 128, 0.6);
      }

      .glass-button.red {
        background: linear-gradient(
          135deg,
          rgba(239, 68, 68, 0.4) 0%,
          rgba(220, 38, 38, 0.4) 100%
        );
        border-color: rgba(248, 113, 113, 0.4);
      }

      .glass-button.red:hover {
        box-shadow: 0 6px 24px rgba(239, 68, 68, 0.4);
        border-color: rgba(248, 113, 113, 0.6);
      }

      .glass-table {
        background: rgba(30, 58, 138, 0.15);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(96, 165, 250, 0.2);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      thead {
        background: rgba(30, 58, 138, 0.3);
        border-bottom: 1px solid rgba(96, 165, 250, 0.3);
      }

      th {
        padding: 1rem;
        text-align: left;
        font-weight: 600;
        color: #93c5fd;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
      }

      td {
        padding: 1rem;
        border-bottom: 1px solid rgba(96, 165, 250, 0.1);
      }

      tbody tr {
        transition: background 0.2s ease;
      }

      tbody tr:hover {
        background: rgba(59, 130, 246, 0.1);
      }

      tbody tr:last-child td {
        border-bottom: none;
      }

      input[type="checkbox"] {
        appearance: none;
        -webkit-appearance: none;
        width: 1.5rem;
        height: 1.5rem;
        cursor: pointer;
        background: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 2px solid rgba(96, 165, 250, 0.3);
        border-radius: 0.375rem;
        position: relative;
        transition: all 0.3s ease;
        outline: none;
      }

      input[type="checkbox"]:hover {
        border-color: rgba(96, 165, 250, 0.5);
        background: rgba(15, 23, 42, 0.7);
        box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.1);
      }

      input[type="checkbox"]:checked {
        background: linear-gradient(
          135deg,
          rgba(59, 130, 246, 0.6) 0%,
          rgba(37, 99, 235, 0.6) 100%
        );
        border-color: rgba(96, 165, 250, 0.6);
        box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.15),
          0 4px 12px rgba(59, 130, 246, 0.3);
      }

      input[type="checkbox"]:checked::after {
        content: "✓";
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: #ffffff;
        font-size: 1rem;
        font-weight: bold;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
      }

      input[type="checkbox"]:active {
        transform: scale(0.95);
      }

      .form-container {
        background: rgba(30, 58, 138, 0.2);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(96, 165, 250, 0.2);
        border-radius: 1rem;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
      }

      .input-small {
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
      }

      /* Card styles */
      .card-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .todo-card {
        background: rgba(30, 58, 138, 0.2);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(96, 165, 250, 0.2);
        border-radius: 1rem;
        padding: 1rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
      }

      .todo-card:hover {
        border-color: rgba(96, 165, 250, 0.4);
        box-shadow: 0 6px 24px rgba(59, 130, 246, 0.2);
      }

      .todo-card.completed {
        background: rgba(34, 197, 94, 0.2);
        border-color: rgba(74, 222, 128, 0.3);
        box-shadow: 0 4px 16px rgba(34, 197, 94, 0.2);
      }

      .todo-card.completed:hover {
        border-color: rgba(74, 222, 128, 0.5);
        box-shadow: 0 6px 24px rgba(34, 197, 94, 0.3);
      }

      .card-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        justify-content: space-between;
      }

      .card-left {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1;
        min-width: 0;
      }

      .card-title {
        font-size: 1rem;
        font-weight: 600;
        color: #e2e8f0;
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .card-notes {
        font-size: 0.875rem;
        color: rgba(226, 232, 240, 0.75);
        padding: 0.75rem 1rem 0 1rem;
        width: 100%;
        line-height: 1.5;
      }

      /* Markdown styling in notes */
      .card-notes p {
        margin: 0.25rem 0;
      }

      .card-notes strong {
        color: rgba(226, 232, 240, 0.9);
        font-weight: 600;
      }

      .card-notes em {
        font-style: italic;
      }

      .card-notes code {
        background: rgba(15, 23, 42, 0.5);
        padding: 0.125rem 0.25rem;
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.8rem;
      }

      .card-notes a {
        color: #60a5fa;
        text-decoration: none;
      }

      .card-notes a:hover {
        text-decoration: underline;
      }

      .card-notes ul,
      .card-notes ol {
        margin: 0.25rem 0;
        padding-left: 1.5rem;
      }

      .card-notes li {
        margin: 0.125rem 0;
      }

      .card-notes h1,
      .card-notes h2,
      .card-notes h3,
      .card-notes h4,
      .card-notes h5,
      .card-notes h6 {
        color: rgba(226, 232, 240, 0.9);
        margin: 0.5rem 0 0.25rem 0;
        font-weight: 600;
      }

      .card-notes blockquote {
        border-left: 3px solid rgba(96, 165, 250, 0.5);
        padding-left: 0.75rem;
        margin: 0.5rem 0;
        color: rgba(226, 232, 240, 0.65);
      }

      .card-checkboxes {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        flex-shrink: 0;
      }

      .checkbox-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
      }

      .checkbox-label {
        font-size: 0.625rem;
        color: #93c5fd;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
      }

      .card-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-shrink: 0;
      }

      .icon-button {
        background: rgba(59, 130, 246, 0.2);
        border: 1px solid rgba(96, 165, 250, 0.3);
        border-radius: 0.5rem;
        width: 2rem;
        height: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        color: #93c5fd;
        font-size: 0.875rem;
        padding: 0;
      }

      .icon-button:hover {
        background: rgba(59, 130, 246, 0.4);
        border-color: rgba(96, 165, 250, 0.5);
        transform: translateY(-2px);
      }

      .icon-button.delete {
        background: rgba(239, 68, 68, 0.2);
        border-color: rgba(248, 113, 113, 0.3);
        color: #fca5a5;
      }

      .icon-button.delete:hover {
        background: rgba(239, 68, 68, 0.4);
        border-color: rgba(248, 113, 113, 0.5);
      }

      .icon-button.edit {
        background: rgba(34, 197, 94, 0.2);
        border-color: rgba(74, 222, 128, 0.3);
        color: #86efac;
      }

      .icon-button.edit:hover {
        background: rgba(34, 197, 94, 0.4);
        border-color: rgba(74, 222, 128, 0.5);
      }

      /* Modal/Popup styles */
      .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(8px);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }

      .modal.active {
        display: flex;
      }

      .modal-content {
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(96, 165, 250, 0.3);
        border-radius: 1rem;
        padding: 1.5rem;
        max-width: 500px;
        width: 100%;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
        max-height: 90vh;
        overflow-y: auto;
      }

      .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
      }

      .modal-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #93c5fd;
      }

      .close-button {
        background: none;
        border: none;
        color: #93c5fd;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0;
        width: 2rem;
        height: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
      }

      .close-button:hover {
        background: rgba(59, 130, 246, 0.2);
      }

      .modal-field {
        margin-bottom: 1rem;
      }

      .modal-label {
        display: block;
        font-size: 0.875rem;
        color: #93c5fd;
        margin-bottom: 0.5rem;
        font-weight: 600;
      }

      .modal-buttons {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
      }

      .modal-buttons .glass-button {
        flex: 1;
      }

      /* Priority dots styles */
      .priority-dots-row {
        display: flex;
        justify-content: flex-end;
        padding: 0.5rem 1rem 0 1rem;
      }

      .priority-dots {
        display: flex;
        gap: 0.25rem;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .priority-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(96, 165, 250, 0.2);
        transition: all 0.3s ease;
      }

      .priority-dot.filled {
        background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
        box-shadow: 0 0 6px rgba(96, 165, 250, 0.4);
      }

      /* Priority selector in edit form */
      .priority-selector {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        justify-content: flex-start;
        padding: 0.5rem;
        background: rgba(15, 23, 42, 0.3);
        border-radius: 0.5rem;
      }

      .priority-option {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        cursor: pointer;
      }

      .priority-option input[type="radio"] {
        appearance: none;
        -webkit-appearance: none;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 2px solid rgba(96, 165, 250, 0.3);
        background: rgba(15, 23, 42, 0.5);
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .priority-option input[type="radio"]:checked {
        background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%);
        border-color: rgba(96, 165, 250, 0.6);
        box-shadow: 0 0 8px rgba(96, 165, 250, 0.5);
      }

      .priority-option input[type="radio"]:hover {
        border-color: rgba(96, 165, 250, 0.5);
      }

      .priority-option label {
        font-size: 0.75rem;
        color: #93c5fd;
        cursor: pointer;
      }

      /* Edit mode styles */
      .card-edit-mode {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(96, 165, 250, 0.2);
      }

      .edit-field {
        margin-bottom: 0.75rem;
      }

      .edit-label {
        display: block;
        font-size: 0.75rem;
        color: #93c5fd;
        margin-bottom: 0.25rem;
        font-weight: 600;
      }

      .edit-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
      }

      .edit-actions .glass-button {
        flex: 1;
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
      }

      /* Logo styling */
      .logo-container {
        display: flex;
        justify-content: center;
        margin: 2rem 0;
      }

      .logo-container img {
        max-width: 200px;
        height: auto;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      }

      /* Progress bar styling */
      .progress-container {
        max-width: 600px;
        margin: 2rem auto;
        padding: 0 1rem;
      }

      .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
      }

      .progress-label {
        font-size: 0.875rem;
        color: rgba(226, 232, 240, 0.9);
        font-weight: 600;
      }

      .progress-stats {
        font-size: 0.875rem;
        color: rgba(226, 232, 240, 0.75);
      }

      .progress-bar-wrapper {
        width: 100%;
        height: 24px;
        background: rgba(30, 41, 59, 0.6);
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 12px;
        overflow: hidden;
        backdrop-filter: blur(10px);
        box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.3);
      }

      .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #3b82f6 0%, #60a5fa 100%);
        border-radius: 12px;
        transition: width 0.5s ease;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding-right: 0.75rem;
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);
      }

      .progress-percentage {
        font-size: 0.75rem;
        font-weight: 700;
        color: white;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
      }

      /* Search/Filter styling */
      .search-container {
        max-width: 600px;
        margin: 2rem auto 1.5rem;
        padding: 0 1rem;
      }

      .search-wrapper {
        position: relative;
        width: 100%;
      }

      .search-input {
        width: 100%;
        background: rgba(15, 23, 42, 0.5);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(96, 165, 250, 0.3);
        color: #e2e8f0;
        padding: 0.875rem 1rem 0.875rem 3rem;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
        outline: none;
        font-size: 0.9375rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
      }

      .search-input:focus {
        border-color: rgba(96, 165, 250, 0.6);
        box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.15),
          0 6px 24px rgba(59, 130, 246, 0.25);
        background: rgba(15, 23, 42, 0.7);
      }

      .search-input::placeholder {
        color: rgba(226, 232, 240, 0.4);
      }

      .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(96, 165, 250, 0.6);
        font-size: 1.125rem;
        pointer-events: none;
      }

      .clear-search {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(59, 130, 246, 0.2);
        border: 1px solid rgba(96, 165, 250, 0.3);
        color: rgba(226, 232, 240, 0.7);
        width: 1.75rem;
        height: 1.75rem;
        border-radius: 0.5rem;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 1rem;
        line-height: 1;
      }

      .clear-search:hover {
        background: rgba(59, 130, 246, 0.3);
        border-color: rgba(96, 165, 250, 0.5);
        color: rgba(226, 232, 240, 0.9);
      }

      .clear-search.visible {
        display: flex;
      }

      .todo-card.hidden {
        display: none;
      }

      /* Sort options styling */
      .sort-container {
        max-width: 600px;
        margin: 1rem auto 2rem;
        padding: 0 1rem;
      }

      .sort-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
      }

      .sort-label {
        font-size: 0.75rem;
        color: #93c5fd;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
      }

      .sort-controls {
        display: flex;
        gap: 0.5rem;
        align-items: center;
      }

      .sort-dropdown {
        position: relative;
      }

      .dropdown-button {
        background: rgba(30, 58, 138, 0.3);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(96, 165, 250, 0.3);
        color: rgba(226, 232, 240, 0.9);
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .dropdown-button:hover {
        background: rgba(30, 58, 138, 0.5);
        border-color: rgba(96, 165, 250, 0.5);
      }

      .dropdown-menu {
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 0;
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(96, 165, 250, 0.3);
        border-radius: 0.75rem;
        padding: 0.5rem;
        min-width: 150px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
        z-index: 100;
        display: none;
      }

      .dropdown-menu.active {
        display: block;
      }

      .dropdown-item {
        padding: 0.5rem 0.75rem;
        color: rgba(226, 232, 240, 0.9);
        cursor: pointer;
        border-radius: 0.5rem;
        transition: all 0.2s ease;
        font-size: 0.875rem;
      }

      .dropdown-item:hover {
        background: rgba(59, 130, 246, 0.3);
      }

      .dropdown-item.selected {
        background: rgba(59, 130, 246, 0.2);
        color: #60a5fa;
      }

      .sort-direction-toggle {
        background: rgba(30, 58, 138, 0.3);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(96, 165, 250, 0.3);
        color: rgba(226, 232, 240, 0.9);
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        min-width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .sort-direction-toggle:hover {
        background: rgba(30, 58, 138, 0.5);
        border-color: rgba(96, 165, 250, 0.5);
      }

      .sort-direction-toggle.active {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.4) 0%, rgba(37, 99, 235, 0.4) 100%);
        border-color: rgba(96, 165, 250, 0.6);
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
      }

      .sort-tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
        min-height: 32px;
      }

      .sort-tag {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.4) 0%, rgba(37, 99, 235, 0.4) 100%);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(96, 165, 250, 0.6);
        color: #e2e8f0;
        padding: 0.375rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
      }

      .sort-tag:hover {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.5) 0%, rgba(37, 99, 235, 0.5) 100%);
        border-color: rgba(96, 165, 250, 0.8);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
      }

      .sort-tag .remove-icon {
        font-size: 0.875rem;
        opacity: 0.7;
      }

      .sort-tag:hover .remove-icon {
        opacity: 1;
      }

      .sort-tags-empty {
        color: rgba(226, 232, 240, 0.4);
        font-size: 0.75rem;
        font-style: italic;
        padding: 0.5rem 0;
      }

      /* Add button styling */
      .add-button {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
        border: 2px solid rgba(96, 165, 250, 0.3);
        color: white;
        font-size: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4);
        transition: all 0.3s ease;
        z-index: 100;
      }

      .add-button:hover {
        transform: scale(1.1);
        box-shadow: 0 12px 32px rgba(59, 130, 246, 0.6);
        border-color: rgba(96, 165, 250, 0.5);
      }

      /* Modal styling */
      .modal-backdrop {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(8px);
        z-index: 200;
        align-items: center;
        justify-content: center;
      }

      .modal-backdrop.active {
        display: flex;
      }

      .modal-content {
        background: rgba(30, 41, 59, 0.95);
        border: 1px solid rgba(148, 163, 184, 0.2);
        border-radius: 16px;
        padding: 2rem;
        max-width: 500px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(20px);
      }

      .modal-header {
        font-size: 1.5rem;
        font-weight: 700;
        color: #e2e8f0;
        margin-bottom: 1.5rem;
        text-align: center;
      }

      .modal-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .modal-form .glass-input {
        width: 100%;
      }

      .modal-form .glass-button {
        width: 100%;
      }

      .modal-form .edit-field {
        margin-bottom: 0;
      }

      .modal-form .edit-label {
        display: block;
        font-size: 0.875rem;
        color: #93c5fd;
        margin-bottom: 0.5rem;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="container mx-auto py-8 px-4 max-w-7xl">
      <h1>The Rangels</h1>

      <!-- Logo -->
      <div class="logo-container">
        <img src="/das_haus.webp" alt="Das Haus Logo" />
      </div>

      <!-- Progress Bar -->
      <div class="progress-container">
        <div class="progress-header">
          <span class="progress-label">Construction Progress</span>
          <span class="progress-stats"
            ><%= completedItems %> of <%= totalItems %> completed</span
          >
        </div>
        <div class="progress-bar-wrapper">
          <div
            class="progress-bar-fill"
            style="width: <%= progressPercentage %>%"
          >
            <% if (progressPercentage > 15) { %>
            <span class="progress-percentage"><%= progressPercentage %>%</span>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Total Cost Display -->
      <div class="progress-container">
        <div class="progress-header">
          <span class="progress-label">Total Cost (Items Not Purchased)</span>
          <span class="progress-stats" style="font-size: 1.125rem; font-weight: 700; color: #86efac;">
            $<%= totalCostNotPurchased.toFixed(2) %>
          </span>
        </div>
      </div>

      <!-- Search/Filter Input -->
      <div class="search-container">
        <div class="search-wrapper">
          <span class="search-icon">🔍</span>
          <input
            type="text"
            id="taskSearch"
            class="search-input"
            placeholder="Search tasks..."
            oninput="filterTasks()"
          />
          <button class="clear-search" id="clearSearch" onclick="clearSearch()">
            ✕
          </button>
        </div>
      </div>

      <!-- Sort Options -->
      <div class="sort-container">
        <div class="sort-header">
          <span class="sort-label">Sort by</span>
          <div class="sort-controls">
            <div class="sort-dropdown">
              <button class="dropdown-button" onclick="toggleDropdown()">
                <span>Add Filter</span>
                <span>▼</span>
              </button>
              <div class="dropdown-menu" id="sortDropdown">
                <div class="dropdown-item" onclick="addSortTag('name')">Name</div>
                <div class="dropdown-item" onclick="addSortTag('cost')">Cost</div>
                <div class="dropdown-item" onclick="addSortTag('priority')">Priority</div>
              </div>
            </div>
            <button class="sort-direction-toggle" onclick="toggleSortDirection()" id="sortDirection" title="Toggle sort direction">
              ▲
            </button>
          </div>
        </div>
        <div class="sort-tags" id="sortTags">
          <!-- Sort tags will be added here dynamically -->
        </div>
      </div>

      <!-- Add Button -->
      <button
        class="add-button"
        onclick="toggleAddModal()"
        title="Add New Item"
      >
        +
      </button>

      <!-- Add Item Modal -->
      <div
        class="modal-backdrop"
        id="addModal"
        onclick="closeModalOnBackdrop(event)"
      >
        <div class="modal-content">
          <div class="modal-header">Add New Item</div>
          <form action="/add" method="POST" class="modal-form">
            <input
              name="name"
              required
              placeholder="Item name"
              class="glass-input"
            />
            <input
              type="number"
              name="cost"
              placeholder="Cost ($)"
              class="glass-input"
              step="0.01"
              min="0"
              value="0"
            />
            <textarea
              name="notes"
              placeholder="Notes (Markdown supported)"
              class="glass-input"
              style="min-height: 80px; resize: vertical; font-family: inherit;"
            ></textarea>
            <div class="edit-field">
              <label class="edit-label">Priority</label>
              <div class="priority-selector">
                <div class="priority-option">
                  <input type="radio" name="priority" value="1" id="add-priority-1" checked>
                  <label for="add-priority-1">1</label>
                </div>
                <div class="priority-option">
                  <input type="radio" name="priority" value="2" id="add-priority-2">
                  <label for="add-priority-2">2</label>
                </div>
                <div class="priority-option">
                  <input type="radio" name="priority" value="3" id="add-priority-3">
                  <label for="add-priority-3">3</label>
                </div>
                <div class="priority-option">
                  <input type="radio" name="priority" value="4" id="add-priority-4">
                  <label for="add-priority-4">4</label>
                </div>
                <div class="priority-option">
                  <input type="radio" name="priority" value="5" id="add-priority-5">
                  <label for="add-priority-5">5</label>
                </div>
              </div>
            </div>
            <button class="glass-button" type="submit">Add Item</button>
          </form>
        </div>
      </div>

      <div class="card-container">
        <% todos.forEach(todo => { %>
        <div
          class="todo-card <%= (todo.is_purchased && todo.is_installed) ? 'completed' : '' %>"
          id="card-<%= todo.id %>"
          data-notes-html="<%= todo.notes_html.replace(/"/g, '&quot;') %>"
          data-cost="<%= todo.cost || 0 %>"
          data-priority="<%= todo.priority || 0 %>"
          data-name="<%= todo.name.toLowerCase() %>"
        >
          <div class="card-header">
            <div class="card-left">
              <div class="card-checkboxes">
                <div class="checkbox-wrapper">
                  <span class="checkbox-label">Buy</span>
                  <input type="checkbox" <%= todo.is_purchased ? 'checked' : ''
                  %> onchange="quickUpdate(<%= todo.id %>, 'is_purchased',
                  this.checked)">
                </div>
                <div class="checkbox-wrapper">
                  <span class="checkbox-label">Done</span>
                  <input type="checkbox" <%= todo.is_installed ? 'checked' : ''
                  %> onchange="quickUpdate(<%= todo.id %>, 'is_installed',
                  this.checked)">
                </div>
              </div>
              <span class="card-title"><%= todo.name %></span>
            </div>
            <div class="card-left" style="flex: 0 0 auto; min-width: 80px; justify-content: flex-end;">
              <span style="font-size: 0.875rem; font-weight: 600; color: #86efac;">
                $<%= (todo.cost || 0).toFixed(2) %>
              </span>
            </div>
            <div class="card-actions">
              <button
                class="icon-button"
                onclick="toggleDetails(<%= todo.id %>)"
                title="Details"
              >
                ⋯
              </button>
              <button
                class="icon-button edit"
                onclick="toggleEdit(<%= todo.id %>)"
                title="Edit"
              >
                ✎
              </button>
              <form
                action="/delete/<%= todo.id %>"
                method="POST"
                style="display: inline"
                onsubmit="return confirm('Delete <%= todo.name %>?')"
              >
                <button type="submit" class="icon-button delete" title="Delete">
                  🗑
                </button>
              </form>
            </div>
          </div>

          <!-- Priority Dots Row -->
          <% if (todo.priority && todo.priority > 0) { %>
          <div class="priority-dots-row">
            <div class="priority-dots">
              <% for (let i = 1; i <= 5; i++) { %>
                <div class="priority-dot <%= todo.priority >= i ? 'filled' : '' %>"></div>
              <% } %>
            </div>
          </div>
          <% } %>

          <!-- Notes Display -->
          <% if (todo.notes && todo.notes.trim() !== '') { %>
          <div class="card-notes"><%- todo.notes_html %></div>
          <% } %>

          <!-- Edit Mode -->
          <div
            class="card-edit-mode"
            id="edit-<%= todo.id %>"
            style="display: none"
          >
            <form
              action="/update/<%= todo.id %>"
              method="POST"
              onsubmit="return handleEditSubmit(event, <%= todo.id %>)"
            >
              <!-- Hidden inputs for checkbox values -->
              <input type="hidden" name="is_purchased" value="<%= todo.is_purchased ? '1' : '0' %>">
              <input type="hidden" name="is_installed" value="<%= todo.is_installed ? '1' : '0' %>">

              <div class="edit-field">
                <label class="edit-label">Name</label>
                <input
                  name="name"
                  value="<%= todo.name %>"
                  class="glass-input input-small"
                  style="width: 100%"
                  required
                />
              </div>
              <div class="edit-field">
                <label class="edit-label">Purchased On (MM/DD/YY)</label>
                <input
                  type="text"
                  name="purchased_on"
                  value="<%= todo.purchased_on_display || '' %>"
                  class="glass-input input-small"
                  style="width: 100%"
                  placeholder="MM/DD/YY"
                  pattern="\d{1,2}/\d{1,2}/\d{2}"
                />
              </div>
              <div class="edit-field">
                <label class="edit-label">Installed On (MM/DD/YY)</label>
                <input
                  type="text"
                  name="installed_on"
                  value="<%= todo.installed_on_display || '' %>"
                  class="glass-input input-small"
                  style="width: 100%"
                  placeholder="MM/DD/YY"
                  pattern="\d{1,2}/\d{1,2}/\d{2}"
                />
              </div>
              <div class="edit-field">
                <label class="edit-label">Cost ($)</label>
                <input
                  type="number"
                  name="cost"
                  value="<%= todo.cost || 0 %>"
                  class="glass-input input-small"
                  style="width: 100%"
                  step="0.01"
                  min="0"
                  placeholder="0.00"
                />
              </div>
              <div class="edit-field">
                <label class="edit-label">Notes (Markdown supported)</label>
                <textarea
                  name="notes"
                  class="glass-input input-small"
                  style="width: 100%; min-height: 80px; resize: vertical; font-family: inherit;"
                  placeholder="**bold** *italic* [link](url)"
                ><%= todo.notes || '' %></textarea>
              </div>
              <div class="edit-field">
                <label class="edit-label">Priority</label>
                <div class="priority-selector">
                  <% for (let i = 1; i <= 5; i++) { %>
                  <div class="priority-option">
                    <input type="radio" name="priority" value="<%= i %>" id="priority-<%= todo.id %>-<%= i %>" <%= (todo.priority || 1) === i ? 'checked' : '' %>>
                    <label for="priority-<%= todo.id %>-<%= i %>"><%= i %></label>
                  </div>
                  <% } %>
                </div>
              </div>
              <div class="edit-actions">
                <button
                  type="button"
                  class="glass-button"
                  onclick="toggleEdit(<%= todo.id %>)"
                >
                  Cancel
                </button>
                <button type="submit" class="glass-button green">
                  Save Changes
                </button>
              </div>
            </form>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- Details Modal -->
    <div class="modal" id="detailsModal">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title" id="modalTitle">Item Details</h2>
          <button class="close-button" onclick="closeModal()">×</button>
        </div>
        <div id="modalBody"></div>
      </div>
    </div>

    <script>
      function validateDates(form) {
        const purchasedOn = form.querySelector(
          'input[name="purchased_on"]'
        ).value;
        const installedOn = form.querySelector(
          'input[name="installed_on"]'
        ).value;

        const datePattern = /^(\d{1,2})\/(\d{1,2})\/(\d{2})$/;

        if (purchasedOn && purchasedOn.trim() !== "") {
          const match = purchasedOn.match(datePattern);
          if (!match) {
            alert(
              "Invalid purchased date format. Please use MM/DD/YY (e.g., 12/25/24)"
            );
            return false;
          }
          const month = parseInt(match[1], 10);
          const day = parseInt(match[2], 10);
          if (month < 1 || month > 12 || day < 1 || day > 31) {
            alert(
              "Invalid purchased date. Month must be 1-12 and day must be 1-31."
            );
            return false;
          }
        }

        if (installedOn && installedOn.trim() !== "") {
          const match = installedOn.match(datePattern);
          if (!match) {
            alert(
              "Invalid installed date format. Please use MM/DD/YY (e.g., 12/25/24)"
            );
            return false;
          }
          const month = parseInt(match[1], 10);
          const day = parseInt(match[2], 10);
          if (month < 1 || month > 12 || day < 1 || day > 31) {
            alert(
              "Invalid installed date. Month must be 1-12 and day must be 1-31."
            );
            return false;
          }
        }

        return true;
      }

      function toggleEdit(id) {
        const editSection = document.getElementById(`edit-${id}`);
        if (editSection.style.display === "none") {
          editSection.style.display = "block";
        } else {
          editSection.style.display = "none";
        }
      }

      function toggleDetails(id) {
        const modal = document.getElementById("detailsModal");
        const card = document.getElementById(`card-${id}`);

        // Get todo data from the card
        const name = card.querySelector(".card-title").textContent;
        const isPurchased = card.querySelector(
          'input[onchange*="is_purchased"]'
        ).checked;
        const isInstalled = card.querySelector(
          'input[onchange*="is_installed"]'
        ).checked;

        // Get additional data from edit form
        const editForm = document
          .getElementById(`edit-${id}`)
          .querySelector("form");
        const purchasedOn = editForm.querySelector(
          'input[name="purchased_on"]'
        ).value;
        const installedOn = editForm.querySelector(
          'input[name="installed_on"]'
        ).value;
        const notes = editForm.querySelector('textarea[name="notes"]').value;
        const cost = editForm.querySelector('input[name="cost"]').value;

        // Get rendered markdown HTML from card data attribute
        const notesHtml = card.getAttribute('data-notes-html') || '';

        document.getElementById("modalTitle").textContent = name;
        document.getElementById("modalBody").innerHTML = `
        <div class="modal-field">
          <span class="modal-label">Cost</span>
          <div style="color: #86efac; margin-top: 0.5rem; font-size: 1.25rem; font-weight: 700;">
            $${parseFloat(cost || 0).toFixed(2)}
          </div>
        </div>
        <div class="modal-field">
          <span class="modal-label">Status</span>
          <div style="display: flex; gap: 1rem; margin-top: 0.5rem;">
            <span style="color: ${isPurchased ? "#86efac" : "#fca5a5"};">
              ${isPurchased ? "✓" : "✗"} Purchased
            </span>
            <span style="color: ${isInstalled ? "#86efac" : "#fca5a5"};">
              ${isInstalled ? "✓" : "✗"} Installed
            </span>
          </div>
        </div>
        ${
          purchasedOn
            ? `
        <div class="modal-field">
          <span class="modal-label">Purchased On</span>
          <div style="color: #e2e8f0; margin-top: 0.5rem;">${new Date(
            purchasedOn
          ).toLocaleDateString()}</div>
        </div>
        `
            : ""
        }
        ${
          installedOn
            ? `
        <div class="modal-field">
          <span class="modal-label">Installed On</span>
          <div style="color: #e2e8f0; margin-top: 0.5rem;">${new Date(
            installedOn
          ).toLocaleDateString()}</div>
        </div>
        `
            : ""
        }
        ${
          notesHtml
            ? `
        <div class="modal-field">
          <span class="modal-label">Notes</span>
          <div style="color: #e2e8f0; margin-top: 0.5rem; line-height: 1.5;">${notesHtml}</div>
        </div>
        `
            : ""
        }
      `;

        modal.classList.add("active");
      }

      function closeModal() {
        document.getElementById("detailsModal").classList.remove("active");
      }

      // Close modal when clicking outside
      document
        .getElementById("detailsModal")
        .addEventListener("click", function (e) {
          if (e.target === this) {
            closeModal();
          }
        });

      async function quickUpdate(id, field, value) {
        // Get the card element
        const card = document.getElementById(`card-${id}`);

        // Get current values from edit form
        const editForm = document
          .getElementById(`edit-${id}`)
          .querySelector("form");
        const name = editForm.querySelector('input[name="name"]').value;
        const purchasedOn = editForm.querySelector(
          'input[name="purchased_on"]'
        ).value;
        const installedOn = editForm.querySelector(
          'input[name="installed_on"]'
        ).value;
        const notes = editForm.querySelector('textarea[name="notes"]').value;
        const cost = editForm.querySelector('input[name="cost"]').value;
        const priority = editForm.querySelector('input[name="priority"]:checked').value;

        // Get checkbox values from the visible checkboxes in the card header
        const purchasedCheckbox = card.querySelector('input[onchange*="is_purchased"]');
        const installedCheckbox = card.querySelector('input[onchange*="is_installed"]');

        const isPurchased = field === "is_purchased" ? value : purchasedCheckbox.checked;
        const isInstalled = field === "is_installed" ? value : installedCheckbox.checked;

        // Update hidden inputs in edit form to keep them in sync
        editForm.querySelector('input[name="is_purchased"]').value = isPurchased ? '1' : '0';
        editForm.querySelector('input[name="is_installed"]').value = isInstalled ? '1' : '0';

        // Update the card's completed class immediately for better UX
        if (isPurchased && isInstalled) {
          card.classList.add("completed");
        } else {
          card.classList.remove("completed");
        }

        // Send AJAX request instead of form submission
        const formData = new URLSearchParams();
        formData.append('name', name);
        formData.append('is_purchased', isPurchased ? "on" : "");
        formData.append('is_installed', isInstalled ? "on" : "");
        formData.append('purchased_on', purchasedOn);
        formData.append('installed_on', installedOn);
        formData.append('notes', notes);
        formData.append('cost', cost);
        formData.append('priority', priority);

        try {
          const response = await fetch(`/update/${id}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: formData.toString()
          });

          if (!response.ok) {
            throw new Error('Update failed');
          }
        } catch (error) {
          console.error('Error updating task:', error);
          // Revert the visual change if the update failed
          if (isPurchased && isInstalled) {
            card.classList.remove("completed");
          } else {
            card.classList.add("completed");
          }
          alert('Failed to update task. Please try again.');
        }
      }

      // Handle edit form submission with AJAX
      async function handleEditSubmit(event, id) {
        event.preventDefault();

        const form = event.target;
        const formData = new FormData(form);

        // Validate dates first
        if (!validateDates(form)) {
          return false;
        }

        // Convert checkbox hidden inputs to proper format
        const isPurchased = formData.get('is_purchased') === '1';
        const isInstalled = formData.get('is_installed') === '1';

        const urlEncodedData = new URLSearchParams();
        urlEncodedData.append('name', formData.get('name'));
        urlEncodedData.append('purchased_on', formData.get('purchased_on'));
        urlEncodedData.append('installed_on', formData.get('installed_on'));
        urlEncodedData.append('notes', formData.get('notes'));
        urlEncodedData.append('cost', formData.get('cost'));
        urlEncodedData.append('priority', formData.get('priority'));
        urlEncodedData.append('is_purchased', isPurchased ? 'on' : '');
        urlEncodedData.append('is_installed', isInstalled ? 'on' : '');

        try {
          const response = await fetch(`/update/${id}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: urlEncodedData.toString()
          });

          if (!response.ok) {
            throw new Error('Update failed');
          }

          // Reload the page to show updated content (markdown rendering, etc.)
          window.location.reload();
        } catch (error) {
          console.error('Error updating task:', error);
          alert('Failed to update task. Please try again.');
        }

        return false;
      }

      // Toggle add modal
      function toggleAddModal() {
        const modal = document.getElementById("addModal");
        modal.classList.toggle("active");
      }

      // Close modal when clicking on backdrop
      function closeModalOnBackdrop(event) {
        if (event.target.id === "addModal") {
          toggleAddModal();
        }
      }

      // Filter tasks based on search input
      function filterTasks() {
        const searchInput = document.getElementById("taskSearch");
        const clearButton = document.getElementById("clearSearch");
        const searchTerm = searchInput.value.toLowerCase().trim();
        const cards = document.querySelectorAll(".todo-card");

        // Show/hide clear button
        if (searchTerm.length > 0) {
          clearButton.classList.add("visible");
        } else {
          clearButton.classList.remove("visible");
        }

        // Filter cards
        cards.forEach((card) => {
          const title = card.querySelector(".card-title").textContent.toLowerCase();
          const notesElement = card.querySelector(".card-notes");
          const notes = notesElement ? notesElement.textContent.toLowerCase() : "";

          if (title.includes(searchTerm) || notes.includes(searchTerm)) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });
      }

      // Clear search input and show all tasks
      function clearSearch() {
        const searchInput = document.getElementById("taskSearch");
        const clearButton = document.getElementById("clearSearch");
        searchInput.value = "";
        clearButton.classList.remove("visible");

        // Show all cards
        const cards = document.querySelectorAll(".todo-card");
        cards.forEach((card) => {
          card.classList.remove("hidden");
        });

        // Focus back on search input
        searchInput.focus();
      }

      // Sort filter state
      let sortFilters = [];
      let sortDirection = 'asc'; // 'asc' or 'desc'

      // Toggle dropdown
      function toggleDropdown() {
        const dropdown = document.getElementById('sortDropdown');
        dropdown.classList.toggle('active');
      }

      // Close dropdown when clicking outside
      document.addEventListener('click', function(event) {
        const dropdown = document.querySelector('.sort-dropdown');
        if (dropdown && !dropdown.contains(event.target)) {
          document.getElementById('sortDropdown').classList.remove('active');
        }
      });

      // Add sort tag
      function addSortTag(filterType) {
        // Check if filter already exists
        if (sortFilters.includes(filterType)) {
          return;
        }

        // Add to filters array
        sortFilters.push(filterType);

        // Update UI
        renderSortTags();

        // Close dropdown
        document.getElementById('sortDropdown').classList.remove('active');

        // Apply sorting
        applySorting();
      }

      // Remove sort tag
      function removeSortTag(filterType) {
        sortFilters = sortFilters.filter(f => f !== filterType);
        renderSortTags();
        applySorting();
      }

      // Render sort tags
      function renderSortTags() {
        const container = document.getElementById('sortTags');
        const filterLabels = {
          'name': 'Name',
          'cost': 'Cost',
          'priority': 'Priority'
        };

        if (sortFilters.length === 0) {
          container.innerHTML = '<div class="sort-tags-empty">No sorting applied</div>';
        } else {
          container.innerHTML = sortFilters.map(filter => `
            <div class="sort-tag" onclick="removeSortTag('${filter}')">
              <span>${filterLabels[filter]}</span>
              <span class="remove-icon">✕</span>
            </div>
          `).join('');
        }

        // Update dropdown items to show selected state
        document.querySelectorAll('.dropdown-item').forEach(item => {
          const filterType = item.textContent.toLowerCase();
          if (sortFilters.includes(filterType)) {
            item.classList.add('selected');
          } else {
            item.classList.remove('selected');
          }
        });
      }

      // Toggle sort direction
      function toggleSortDirection() {
        sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
        const button = document.getElementById('sortDirection');
        button.textContent = sortDirection === 'asc' ? '▲' : '▼';
        button.classList.toggle('active');
        applySorting();
      }

      // Apply sorting based on active filters
      function applySorting() {
        if (sortFilters.length === 0) {
          return;
        }

        const container = document.querySelector(".card-container");
        const cards = Array.from(container.querySelectorAll(".todo-card"));

        // Sort cards based on multiple criteria
        cards.sort((a, b) => {
          for (let filter of sortFilters) {
            let aValue, bValue, comparison;

            switch(filter) {
              case 'name':
                aValue = a.dataset.name || "";
                bValue = b.dataset.name || "";
                comparison = aValue.localeCompare(bValue);
                break;

              case 'cost':
                aValue = parseFloat(a.dataset.cost) || 0;
                bValue = parseFloat(b.dataset.cost) || 0;
                comparison = aValue - bValue;
                break;

              case 'priority':
                aValue = parseInt(a.dataset.priority) || 0;
                bValue = parseInt(b.dataset.priority) || 0;
                comparison = aValue - bValue;
                break;

              default:
                comparison = 0;
            }

            // If values are different, return the comparison
            if (comparison !== 0) {
              return sortDirection === 'asc' ? comparison : -comparison;
            }
            // If equal, continue to next filter
          }

          return 0;
        });

        // Reorder cards in DOM
        cards.forEach(card => {
          container.appendChild(card);
        });
      }

      // Initialize empty state on page load
      document.addEventListener('DOMContentLoaded', function() {
        renderSortTags();
      });
    </script>
  </body>
</html>
